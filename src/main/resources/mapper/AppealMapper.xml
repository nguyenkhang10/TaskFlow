<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.taskflow.mapper.AppealMapper">

    <resultMap id="AppealResult" type="Appeal">
        <id     property="id"        column="id"/>
        <result property="username"  column="username"/>
        <result property="title"     column="title"/>
        <result property="content"   column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        id, username, title, content, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="Appeal" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO appeal (username, title, content)
        VALUES (#{username}, #{title}, #{content})
    </insert>

    <select id="findById" resultMap="AppealResult">
        SELECT <include refid="columns"/>
        FROM appeal
        WHERE id = #{id}
    </select>

    <select id="search" resultMap="AppealResult">
        SELECT <include refid="columns"/>
        FROM appeal
        <where>
            <if test="username != null and username != ''">
                AND username ILIKE '%' || #{username} || '%'
            </if>
            <if test="keyword != null and keyword != ''">
                AND (title ILIKE '%' || #{keyword} || '%'
                OR content ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <delete id="deleteById">
        DELETE FROM appeal WHERE id = #{id}
    </delete>

</mapper>
