<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.taskflow.mapper.UserMapper">

    <resultMap id="UserResult" type="User">
        <id     property="id"           column="id"/>
        <result property="username"     column="username"/>
        <result property="email"        column="email"/>
        <result property="fullName"     column="full_name"/>
        <result property="passwordHash" column="password_hash"/>  <!-- BCrypt hash -->
        <result property="createdAt"    column="created_at"/>
        <result property="updatedAt"    column="updated_at"/>
    </resultMap>

    <sql id="columns">
        id, username, email, full_name, password_hash, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app_user (username, email, full_name)
        VALUES (#{username}, #{email}, #{fullName})
    </insert>

    <select id="findById" resultMap="UserResult">
        SELECT <include refid="columns"/>
        FROM app_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="UserResult">
        SELECT <include refid="columns"/>
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="findByEmail" resultMap="UserResult">
        SELECT <include refid="columns"/>
        FROM app_user
        WHERE email = #{email}
    </select>

    <select id="search" resultMap="UserResult">
        SELECT <include refid="columns"/>
        FROM app_user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username ILIKE '%' || #{keyword} || '%'
                OR email ILIKE '%' || #{keyword} || '%'
                OR full_name ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <update id="update" parameterType="User">
        UPDATE app_user
        SET username   = #{username},
            email      = #{email},
            full_name  = #{fullName},
            updated_at = now()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM app_user WHERE id = #{id}
    </delete>

</mapper>
