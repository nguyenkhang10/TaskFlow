<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.taskflow.mapper.PasswordResetTokenMapper">

    <resultMap id="TokenResult" type="com.example.taskflow.domain.PasswordResetToken">
        <id     property="id"        column="id"/>
        <result property="userId"    column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="usedAt"    column="used_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.taskflow.domain.PasswordResetToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO password_reset_token (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <select id="findByTokenHash" resultMap="TokenResult">
        SELECT id, user_id, token_hash, expires_at, used_at, created_at
        FROM password_reset_token
        WHERE token_hash = #{tokenHash}
    </select>

    <!-- "AND used_at IS NULL" giúp chống 2 request dùng cùng 1 token cùng lúc -->
    <update id="markUsed">
        UPDATE password_reset_token
        SET used_at = now()
        WHERE id = #{id} AND used_at IS NULL
    </update>

    <update id="invalidateAllByUserId">
        UPDATE password_reset_token
        SET used_at = now()
        WHERE user_id = #{userId} AND used_at IS NULL
    </update>
</mapper>